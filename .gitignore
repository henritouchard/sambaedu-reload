# Laravel
/node_modules
/public/hot
/public/storage
/storage/*.key
# Story 16.10 — PKI locale + JWT (clés privées sensibles, jamais en VCS)
/storage/keys/
# Story 3.6 / 3.10 — sources d'install runtime (ISO + pack pilotes NIC WinPE),
# server-side, non client-facing → jamais en VCS (project_storage_convention_non_versioned).
/storage/install/
# Story 38.1 — statiques iPXE PROVISIONNÉS par ensure_ipxe_statics (update.sh)
# depuis resources/ipxe/static/ (versionné) : la cible storage/ est non versionnée
# (project_storage_convention_non_versioned).
/storage/ipxe/
/bootstrap/cache/
!/bootstrap/cache/.gitkeep
.env
.env.backup
.env.testing
.env.*.php
.phpunit.result.cache
Homestead.json
Homestead.yaml

# Composer
/vendor

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
.phpunit.result.cache
coverage/
.pest/

# Build artifacts
/public/css/*
/public/js/*
/public/build/*
/public/vendor/*
/public/packages/*
public/mix-manifest.json
public/js/app.js
public/css/app.css

# NPM / Vite
package-lock.json
yarn.lock
pnpm-lock.yaml
# Story 52.1 — userDoc/ est un projet npm ISOLÉ (site de doc publique
# VitePress) : son package-lock.json est délibérément COMMITTÉ (build
# reproductible sur la VM, cf. AC2), à l'inverse du package-lock.json de
# l'application ignoré ci-dessus.
!/userDoc/package-lock.json

# Logs (les dossiers storage/* ont leur propre .gitignore qui préserve la structure)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Swagger / API docs générés
/storage/api-docs/

# Wallpaper previews (story 4.7 — WallpaperPreviewCommand)
/storage/app/wallpaper-previews/

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE settings
.editorconfig
*.sublime-project
*.sublime-workspace

# Temporary files
*.tmp
*.temp
*.bak

/sambaedu

# Agent Go (story 24.5) : artefacts de build non versionnés (convention
# storage — le binaire de prod sera déposé dans storage/agent/releases/ par
# 25.1) ; jamais de PFX/clé privée dans le repo.
/agent/build/dist/
# Binaires compilés à la racine du module (go build / cross-compile ad hoc),
# ex. agent/windows.exe — ne jamais versionner.
/agent/*.exe
*.pfx

# Story 25.6 : skin d'overlay Rainmeter PROVISIONNÉE (copie de la canonique
# versionnée resources/overlay/rainmeter/…) — convention storage NON versionné,
# servie par la route agent. L'autorité reste resources/ ; cette copie est
# régénérée par OverlaySkinProvisioner (chown www-admin requis en prod).
/storage/assets/overlay/

# Laravel Dusk (host isolé)
.env.dusk
/database/dusk.sqlite

# Config Claude Code locale (skills, scripts, settings…) — non versionnée.
/.claude/

# BMAD — install et artefacts de sortie sortis du tracking git
# (conservés localement uniquement).
/_bmad/
/_bmad-output/

# userDoc — site de documentation publique VitePress (Story 52.1). Chaîne
# npm ISOLÉE de l'application (package.json/package-lock.json propres,
# committés — cf. exception ci-dessus). node_modules et sorties de build non
# versionnés : userDoc/dist/ est reconstruit intégralement par
# ensure_user_doc() (scripts/update.sh) à chaque déploiement, jamais commité.
/userDoc/node_modules/
/userDoc/dist/
/userDoc/.vitepress/dist/
/userDoc/.vitepress/cache/

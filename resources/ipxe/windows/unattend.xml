	<settings pass="oobeSystem">
		<component xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
			<AutoLogon>
				<Password>
					<Value></Value>
					<PlainText>true</PlainText>
				</Password>
				<Domain></Domain>
				<Enabled>true</Enabled>
				<LogonCount>2</LogonCount>
				<Username></Username>
			</AutoLogon>
			<ComputerName></ComputerName>
			<OOBE>
				<HideEULAPage>true</HideEULAPage>
				<HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
				<HideOnlineAccountScreens>true</HideOnlineAccountScreens>
				<HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
				<NetworkLocation>Work</NetworkLocation>
				<SkipUserOOBE>true</SkipUserOOBE>
				<SkipMachineOOBE>true</SkipMachineOOBE>
				<ProtectYourPC>3</ProtectYourPC>
			</OOBE>
			<UserAccounts>
				<AdministratorPassword>
					<Value></Value>
					<PlainText>true</PlainText>
				</AdministratorPassword>
				<LocalAccounts></LocalAccounts>
			</UserAccounts>
			<RegisteredOrganization>SambaEdu</RegisteredOrganization>
			<RegisteredOwner></RegisteredOwner>
			<DisableAutoDaylightTimeSet>false</DisableAutoDaylightTimeSet>
			<TimeZone>Romance Standard Time</TimeZone>
			<FirstLogonCommands>
				<!-- Story 23.3 : l'enrôlement agent DOIT précéder le curl oobe — l'action.cmd
				     récupéré peut rebooter le poste en ~5 s. Le dossier est créé ET verrouillé
				     (héritage coupé) AVANT l'échange : le token n'existe jamais dans un dossier
				     aux ACL héritées (Users-readable) ; si le verrouillage échoue, on n'échange
				     pas (ticket non consommé → porte 2). Échec non bloquant : sans réseau on
				     retente 30×10 s ; un 4xx définitif arrête tout de suite, un 5xx/429
				     transitoire est retenté. ACL via SID (S-1-5-18 = SYSTEM, S-1-5-32-544 =
				     Administrators) : insensible à la locale Windows. -->
				<SynchronousCommand wcm:action="add">
					<Order>1</Order>
					<Description>agent enrollment</Description>
					<RequiresUserInput>false</RequiresUserInput>
					<CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "New-Item -Force -ItemType Directory 'C:\ProgramData\SambaEdu\Agent' | Out-Null; icacls 'C:\ProgramData\SambaEdu\Agent' /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' | Out-Null; if ($LASTEXITCODE -ne 0) { exit 0 }; for ($i=0; $i -lt 30; $i++) { try { $r = Invoke-RestMethod -Method Post -Uri 'http://###_SE4FS_NAME_###/api/v1/agent/enrollment' -Body @{ticket='###_AGENT_ENROLL_TICKET_###'; uuid='###_UUID_###'; mac='###_MAC_###'; hostname='###_NAME_###'}; if ($r.token) { Set-Content -NoNewline -Path 'C:\ProgramData\SambaEdu\Agent\token' -Value $r.token }; break } catch { $s = 0; if ($_.Exception.Response) { $s = [int]$_.Exception.Response.StatusCode }; if ($s -ge 400 -and $s -lt 500 -and $s -ne 429) { break }; Start-Sleep -Seconds 10 } }; exit 0"</CommandLine>
				</SynchronousCommand>
				<SynchronousCommand wcm:action="add">
					<Order>2</Order>
					<Description>agent token acl</Description>
					<RequiresUserInput>false</RequiresUserInput>
					<CommandLine>%comspec% /c if exist "C:\ProgramData\SambaEdu\Agent\token" (icacls "C:\ProgramData\SambaEdu\Agent" /inheritance:r /grant:r "*S-1-5-18:(OI)(CI)F" "*S-1-5-32-544:(OI)(CI)F")</CommandLine>
				</SynchronousCommand>
				<!-- Story 25.4 (porte 1, FR16) : APRÈS l'obtention du token (Order 1) et le
				     durcissement ACL (Order 2), on dépose la racine CA + le binaire stable + on
				     enregistre le service. Le poste neuf finit avec un agent vivant DÉJÀ enrôlé
				     (token présent → convergence immédiate), sans GPO. Échec NON BLOQUANT
				     (try/catch, exit 0) : un poste dont l'install agent échoue retombe sur le
				     filet GPO au prochain boot. Le binaire est déposé à son emplacement DÉFINITIF
				     (C:\Program Files\SambaEdu\Agent\agent.exe) AVANT `install` — le SCM enregistre
				     ce chemin (piège n° 10). CA = certutil -addstore -f Root, idempotent (piège
				     n° 14). Endpoints d'amorçage NON authentifiés (LAN), sans bearer. -->
				<SynchronousCommand wcm:action="add">
					<Order>3</Order>
					<Description>agent install (ca + binaire stable + service)</Description>
					<RequiresUserInput>false</RequiresUserInput>
					<CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $dir='C:\Program Files\SambaEdu\Agent'; New-Item -Force -ItemType Directory $dir | Out-Null; $ca=Join-Path $env:TEMP 'se4-ca.crt'; Invoke-WebRequest -UseBasicParsing -Uri 'http://###_SE4FS_NAME_###/api/v1/agent/ca' -OutFile $ca; certutil -addstore -f Root $ca | Out-Null; $exe=Join-Path $dir 'agent.exe'; Invoke-WebRequest -UseBasicParsing -Uri 'http://###_SE4FS_NAME_###/api/v1/agent/stable/download' -OutFile $exe; &amp; $exe install -server-url 'http://###_SE4FS_NAME_###' } catch { } exit 0"</CommandLine>
				</SynchronousCommand>
				<SynchronousCommand wcm:action="add">
					<Order>4</Order>
					<Description>postinst curl</Description>
					<RequiresUserInput>false</RequiresUserInput>
					<CommandLine>%comspec% /c curl -sL --retry 20 --retry-max-time 300 --fail -F "etape=oobe" -F "name=###_NAME_###" -F "uuid=###_UUID_###" -F "mac=###_MAC_###" -F "ret=0" -o "%windir%\action.cmd" "http://###_SE4FS_NAME_###/ipxe/windows/action"</CommandLine>
				</SynchronousCommand>
				<SynchronousCommand wcm:action="add">
					<Order>5</Order>
					<Description>postinst action</Description>
					<RequiresUserInput>false</RequiresUserInput>
					<CommandLine>%comspec% /c if exist %windir%\action.cmd (call %windir%\action.cmd)</CommandLine>
				</SynchronousCommand>
				<!-- Reboot terminal de fin d'install (ère agent) : porte le `shutdown -r`
				     du legacy `cmd_oobe` (action.php:260), jamais porté car `handleOobe`
				     renvoie un body vide (action.cmd 0 octet). Sans lui, la session OOBE
				     se4install finit ses FirstLogonCommands et reste ouverte sans reboot.
				     `/t 30` laisse une fenêtre ; si un action.cmd futur planifie déjà un
				     shutdown, ce 2e appel no-op (1190 « shutdown already in progress »).
				     Pas de boucle : LogonCount=2 mais les FirstLogonCommands ne tournent
				     qu'au 1er logon. Marqueur install.log posé pour le suivi (parité
				     legacy `cmd_oobe`). -->
				<SynchronousCommand wcm:action="add">
					<Order>6</Order>
					<Description>reboot fin install</Description>
					<RequiresUserInput>false</RequiresUserInput>
					<CommandLine>%comspec% /c (if not exist c:\netinst md c:\netinst) &amp; echo install finie&gt;c:\netinst\install.log &amp; shutdown /r /t 30 /c "Installation terminee, redemarrage"</CommandLine>
				</SynchronousCommand>
			</FirstLogonCommands>
		</component>
	</settings>
</unattend>

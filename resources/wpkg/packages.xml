<?xml version="1.0" encoding="UTF-8"?>
<packages>
    <package id="7zip" name="7-Zip" revision="25.01" reboot="false" priority="10" category="Bureautique" lnk="7-Zip" category2="Bureautique" compatibilite="7">
        <!-- Mise a jour par Laurent Joly -->

        <windows type="winget" id="7zip.7zip"/>

        <variable name="PROGRAMFILES" value="%PROGRAMFILES%" architecture="x86"/>
        <variable name="PROGRAMFILES" value="%PROGRAMFILES%" architecture="x64"/>

        <!-- Telechargement des installeurs -->
        
        

        <!-- Nettoyage des vieux fichiers d'installation -->
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        

        <!-- Mise à jour -->
        <upgrade include="install"/>
        <downgrade include="install"/>

        <!-- Vérification de la version -->
        <check type="file" condition="versiongreaterorequal" path="%PROGRAMFILES%\7-Zip\7zFM.exe" value="25.1.0.0"/>

        <!-- Installation -->
        <install include="remove"/>
        <install cmd="&quot;%Z%\packages\7zip\7z.exe&quot; /S" architecture="x86">
            <exit code="0"/>
        </install>
        <install cmd="&quot;%Z%\packages\7zip\7z-x64.exe&quot; /S" architecture="x64">
            <exit code="0"/>
        </install>

        <!-- Désinstallation des differentes versions -->
        <remove cmd="%COMSPEC% /c if exist &quot;%PROGRAMFILES%/7-Zip/Uninstall.exe&quot; &quot;%PROGRAMFILES%/7-Zip/Uninstall.exe&quot; /S"/>

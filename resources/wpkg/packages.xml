    <package id="NotepadPlusPlus" name="NotepadPlusPlus" revision="8.9.1.0" reboot="false" priority="1" category="Informatique" lnk="Notepad++.lnk" category2="Informatique" compatibilite="7">
        <!-- Version de Laurent Joly
            Deplacement raccourci Menu demarrer Francky
        -->

        <windows type="winget" id="Notepad++.Notepad++"/>

        
        

        
        
        
        
        
        
        
        

        <variable name="AllUsersPrograms" value="%ALLUSERSPROFILE%\Menu Démarrer\Programmes" os="5\.\d\.\d{4}"/>
        <variable name="AllUsersPrograms" value="%ALLUSERSPROFILE%\Microsoft\Windows\Start Menu\Programs" os="(6|10)\.\d\.\d{4}"/>

        <check type="file" condition="versiongreaterorequal" path="%ProgramFiles%\Notepad++\notepad++.exe" value="8.9.1.0"/>

        <install include="remove"/>

        <install cmd="%Z%\packages\NotepadPlusPlus\npp.Installer.exe /S" architecture="x86"/>
        <install cmd="%Z%\packages\NotepadPlusPlus\npp.Installer.x64.exe /S" architecture="x64"/>

        <install cmd="%ComSpec% /C if exist &quot;%ALLUSERSPROFILE%\Bureau\Notepad++.lnk&quot; del /F /Q &quot;%ALLUSERSPROFILE%\Bureau\Notepad++.lnk&quot;"/>
        <install cmd="%ComSpec% /C if exist &quot;%PROGRAMFILES%\Notepad++\disabled-updater&quot; rmdir /S /Q &quot;%PROGRAMFILES%\Notepad++\disabled-updater&quot;"/>
        <install cmd="%ComSpec% /C if exist &quot;%PROGRAMFILES(x86)%\Notepad++\disabled-updater&quot; rmdir /S /Q &quot;%PROGRAMFILES(x86)%\Notepad++\disabled-updater&quot;" architecture="x64"/>
        <install cmd="%ComSpec% /C if exist &quot;%PROGRAMFILES%\Notepad++\updater&quot; move &quot;%PROGRAMFILES%\Notepad++\updater&quot; &quot;%PROGRAMFILES%\Notepad++\disabled-updater&quot;"/>
        <install cmd="%ComSpec% /C if exist &quot;%PROGRAMFILES(x86)%\Notepad++\updater&quot; move &quot;%PROGRAMFILES(x86)%\Notepad++\updater&quot; &quot;%PROGRAMFILES(x86)%\Notepad++\disabled-updater&quot;" architecture="x64"/>

        <upgrade include="install"/>
        <downgrade include="install"/>

        <!-- Suppression du fichier disabled-updater cree dans des vieilles versions du xml  -->
        <remove cmd="%COMSPEC% /C if exist &quot;%PROGRAMFILES%\Notepad++\disabled-updater&quot; rmdir /S /Q &quot;%PROGRAMFILES%\Notepad++\disabled-updater&quot;"/>
        <remove cmd="%COMSPEC% /C if exist &quot;%PROGRAMFILES(x86)%\Notepad++\disabled-updater&quot; rmdir /S /Q &quot;%PROGRAMFILES(x86)%\Notepad++\disabled-updater&quot;" architecture="x64"/>
        <remove cmd="%ComSpec% /C if exist &quot;%ProgramFiles%\Notepad++\plugins&quot; del /f /q &quot;%ProgramFiles%\Notepad++\plugins\*.dll&quot;"/>
        <remove cmd="%ComSpec% /C if exist &quot;%ProgramFiles(x86)%\Notepad++\plugins&quot; del /f /q &quot;%ProgramFiles(x86)%\Notepad++\plugins\*.dll&quot;" architecture="x64"/>
        <remove cmd="%ComSpec% /C if exist &quot;%ProgramFiles%\Notepad++\uninstall.exe&quot; &quot;%ProgramFiles%\Notepad++\uninstall.exe&quot; /S" timeout="300"/>
        <remove cmd="%ComSpec% /C if exist &quot;%ProgramFiles(x86)%\Notepad++\uninstall.exe&quot; &quot;%ProgramFiles(x86)%\Notepad++\uninstall.exe&quot; /S" architecture="x64" timeout="300"/>
        <!-- Suppression du lnk dans Bureautique cree dans la version precedente a cause d'un changement de category non prévu  -->
        <remove cmd="%ComSpec% /C if exist &quot;%AllUsersPrograms%\Bureautique\Notepad++&quot; rmdir /S /Q &quot;%AllUsersPrograms%\Bureautique\Notepad++&quot;"/>
        <remove cmd="%ComSpec% /C ping -n 30 localhost &gt;NUL"/>

    </package>
	<!-- mise a jour par Laurent Joly -->
	<package id="animationsvt" name="Animations de SVT" revision="1.0" Reboot="false" priority="1" category="SVT" compatibilite="7" category2="SVT" lnk="Animation SVT">
		<variable name="PROGRAMFILES" value="%PROGRAMFILES%" architecture="x86"/>
		<variable name="PROGRAMFILES" value="%PROGRAMFILES(X86)%" architecture="x64"/>
		<variable name="ComSpec" value="%SystemRoot%\System32\cmd.exe" architecture="x86"/>
		<variable name="ComSpec" value="%SystemRoot%\SysWOW64\cmd.exe" architecture="x64"/>
		<variable name="AllUsersPrograms" value="%ALLUSERSPROFILE%\Menu Démarrer\Programmes" os="5\.\d\.\d{4}"/>
		<variable name="AllUsersPrograms" value="%ALLUSERSPROFILE%\Microsoft\Windows\Start Menu\Programs" os="(6|10)\.\d\.\d{4}"/>
		
		<!--  Depend de flash Stand Alone -->
		<depends package-id="flashSA"/>
		
		<!-- Nettoyage des vieux fichiers d'installation -->
		<!-- Aucun -->
		<!-- Téléchargement -->
		
		<!-- Verification de la version -->
		<check type="registry" condition="equals" path="HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\{534AECD5-C726-4535-93BB-0D9481102799}\DisplayVersion" value="1.0" architecture="x64"/>
		<check type="registry" condition="equals" path="HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{534AECD5-C726-4535-93BB-0D9481102799}\DisplayVersion" value="1.0" architecture="x86"/>
		<!-- deinstallation des versions précédentes -->
		<install include="remove"/>
		<!-- Installation -->
		<install cmd="msiexec /qn /i &quot;%Z%\packages\SVT\animationsvt.msi&quot;"/>
	
		<upgrade include="install"/>
		<downgrade include="upgrade"/>
		<!-- Desinstallation -->
		<remove cmd="MsiExec.exe /X{534AECD5-C726-4535-93BB-0D9481102799} /qn">
		  <exit code="1605" reboot="false"/>
		  <exit code="1612" reboot="false"/>
		</remove>
		<remove cmd="%ComSpec% /C If Exist &quot;%PROGRAMFILES%\Animation SVT&quot; rd /S /Q &quot;%PROGRAMFILES%\Animation SVT&quot;"/>
	</package>
    <!-- mise à jour par Laurent Joly et Tom Ricci -->
    <package id="firefox" name="Firefox ESR" revision="140.10.1" reboot="false" priority="3" category="Internet" lnk="Mozilla Firefox.lnk" category2="Internet" compatibilite="7">

        <linux type="apt" package="firefox-esr"/>
        <windows type="winget" id="Mozilla.Firefox.ESR.fr"/>

        <variable name="SE4FS_NAME" value="se4fs_name" source="sambaedu"/>

        <check type="file" condition="versiongreaterorequal" path="%PROGRAMFILES%\Mozilla Firefox\firefox.exe" value="140.10.1" os="(6|10)\.\d\.\d{4}"/>

        
        

        
        
        

        <!-- Avant l'installation de la nouvelle version, on désinstalle la précédente
        <install include="remove"/>
         -->
        <!-- En cas de mise à jour vers la version actuelle -->
        <upgrade include="install"/>
        <downgrade include="install"/>

        <install cmd="%Z%\packages\firefox\FirefoxSetup-x64.exe /S /MaintenanceService=false" timeout="1800" architecture="x64" os="(6|10)\.\d\.\d{4}"/>
        <install cmd="%Z%\packages\firefox\FirefoxSetup-x86.exe /S /MaintenanceService=false" timeout="1800" architecture="x86" os="(6|10)\.\d\.\d{4}"/>

        <!-- Récupère et applique les paramètres définis sur SE4 -->
        <install cmd="%ComSpec% /C curl -o &quot;%TEMP%\applications-firefox.cmd&quot; -F &quot;os=windows&quot; -F &quot;action=wpkg&quot; -F &quot;application=firefox&quot; -F &quot;machine=%computername%&quot; &quot;http://%SE4FS_NAME%/gpo/applications.php&quot; &gt; NUL"/>
        <install cmd="%ComSpec% /C if exist &quot;%TEMP%\applications-firefox.cmd&quot; call &quot;%TEMP%\applications-firefox.cmd&quot;"/>

        <!-- Remove -->
        <remove cmd="%ComSpec% /C if exist &quot;%ProgramFiles%\Mozilla Firefox\uninstall\helper.exe&quot; &quot;%ProgramFiles%\Mozilla Firefox\uninstall\helper.exe&quot; /S" timeout="1200"/>
        <!-- Wait for some time -->
        <remove cmd="%ComSpec% /c ping localhost /n 20"/>
        <remove cmd="%ComSpec% /C if exist &quot;%PUBLIC%\Desktop\Mozilla Firefox.lnk&quot; DEL /F /Q &quot;%PUBLIC%\Desktop\Mozilla Firefox.lnk&quot;"/>
        <remove cmd="%ComSpec% /C if exist &quot;%USERPROFILE%\Desktop\Mozilla Firefox.lnk&quot; DEL /F /Q &quot;%USERPROFILE%\Desktop\Mozilla Firefox.lnk&quot;"/>
        <remove cmd="%ComSpec% /C if exist &quot;%ProgramFiles%\Mozilla Firefox\&quot; RMDIR /S /Q &quot;%ProgramFiles%\Mozilla Firefox\&quot;"/>

        <Association Identifier=".html" ProgId="FirefoxHTML-308046B0AF4A39CB" ApplicationName="Firefox" type="file"/>
        <Association Identifier=".htm" ProgId="FirefoxHTML-308046B0AF4A39CB" ApplicationName="Firefox" type="file"/>
        <Association Identifier="https" ProgId="FirefoxHTML-308046B0AF4A39CB" ApplicationName="Firefox" type="protocol"/>
        <Association Identifier="http" ProgId="FirefoxHTML-308046B0AF4A39CB" ApplicationName="Firefox" type="protocol"/>
        <Association Identifier="read" ProgId="FirefoxHTML-308046B0AF4A39CB" ApplicationName="Firefox" type="protocol"/>

    </package>
</packages>

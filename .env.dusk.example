# Environnement Laravel Dusk — tests e2e HOST ISOLÉ (pas la VM).
# Copier vers `.env.dusk` (git-ignoré) et adapter les chemins Chrome.
# Chargé quand APP_ENV=dusk. serve + process de test le partagent, ainsi que
# la même base sqlite FICHIER (`:memory:` est per-process → inutilisable).

APP_NAME=SambaEdu
APP_ENV=dusk
APP_DEBUG=true
# Clé de test uniquement (identique à phpunit.xml) — ne déchiffre aucun secret prod.
APP_KEY=base64:ffV+ltRrvfh14I7SufozBkRu/+HIvXwDmmJDoGCbbS4=
APP_URL=http://127.0.0.1:8000

# --- Base : sqlite FICHIER partagée entre `artisan serve` et le runner.
DB_CONNECTION=sqlite
DB_DATABASE=/ABS/PATH/TO/sambaedu-reload/database/dusk.sqlite

# --- Session/cache : file/array (cross-process, sans APCu ni Redis).
SESSION_DRIVER=file
CACHE_STORE=array
CACHE_DRIVER=array
APP_CONTEXT_CACHE_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
LOG_CHANNEL=single
DEBUGBAR_ENABLED=false
PULSE_ENABLED=false
TELESCOPE_ENABLED=false

# --- LDAP : localhost => refus de connexion INSTANTANÉ (pas de hang au chemin négatif).
LDAP_CONNECTION=default
LDAP_HOST=127.0.0.1
LDAP_PORT=389

# --- Seam happy-path : couple accepté par le login form UNIQUEMENT sous dusk
# (AuthenticationService::matchesDuskTestCredentials + DuskAuthGuard).
DUSK_TEST_LOGIN=dusk-admin
DUSK_TEST_PASSWORD=change-me

# --- Chrome for Testing (téléchargé hors vendor ; ext-zip absent du PHP host
# empêche le download auto de Dusk). Récupérer les binaires linux64 depuis :
# https://googlechromelabs.github.io/chrome-for-testing/
DUSK_CHROMEDRIVER=/ABS/PATH/TO/chromedriver-linux64/chromedriver
DUSK_CHROME_BINARY=/ABS/PATH/TO/chrome-linux64/chrome

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Sambaedu
# Environnement d'exécution: production, staging, local
# en dev: local
APP_ENV=production
# Activer le debug (affiche les erreurs détaillées) - JAMAIS true en production
APP_DEBUG=false
# Fuseau horaire de l'application
APP_TIMEZONE="Europe/Paris"
# URL racine de l'application 
APP_URL=
APP_KEY=
# =============================================================================
# LOGGING
# =============================================================================
# Canal de log: stack, single, daily
# en dev : stack & debug
LOG_CHANNEL=daily
# Niveau de log: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=info

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sambaedu
DB_USERNAME=sambaedu
DB_PASSWORD=

# =============================================================================
# CACHE & SESSIONS & QUEUES
# =============================================================================
# Driver de diffusion en temps réel
BROADCAST_DRIVER=log
# Driver de cache: file, redis, memcached, dynamodb
CACHE_DRIVER=file
# Disque de stockage des fichiers
FILESYSTEM_DISK=local
# File d'attente des jobs: sync, database, redis, beanstalkd
QUEUE_CONNECTION=database
# Stockage de session: file, cookie, database, redis
SESSION_DRIVER=file
# Durée de vie de la session en minutes
SESSION_LIFETIME=120

# =============================================================================
# REDIS (optionnel, utilisé si CACHE_DRIVER=redis ou QUEUE_CONNECTION=redis)
# =============================================================================
REDIS_HOST=127.0.0.1
# Mot de passe Redis - généré automatiquement lors du setup
REDIS_PASSWORD=
REDIS_PORT=6379

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# SAMBAEDU - ÉTABLISSEMENT
# =============================================================================
# Nom affiché de l'établissement (rempli automatiquement depuis
# /etc/sambaedu/sambaedu.conf -> etab_name lors de l'installation si disponible).
# Si vide, config/sambaedu.php applique un fallback.
ESTABLISHMENT_NAME=

# =============================================================================
# ACTIVE DIRECTORY (Samba/AD)
# =============================================================================
# Les paramètres LDAP (host, port, base_dn, admin user/password, domain)
# sont lus depuis /etc/sambaedu/sambaedu.conf via SambaEduConfig — source
# de vérité unique partagée par SER et le bridge legacy.
#
# Serveur AD CENTRAL (fallback en cas d'indisponibilité de l'AD local)
SE4AD_IP=192.168.122.60

# Serveur AD LOCAL de l'établissement (prioritaire pour les requêtes)
SE4AD_ETAB_IP=192.168.122.60

# Restreindre l'accès LDAP au réseau local uniquement
STRICT_LOCAL_AD=true

# =============================================================================
# LEGACY
# =============================================================================
# Chemin absolu vers le legacy PHP
LEGACY_PATH=/var/www/sambaedu
# URL interne du vhost legacy (proxy HTTP pour isolation PHP)
LEGACY_BASE_URL=http://127.0.0.1:8082
# Bloquer l'accès aux routes legacy dont l'équivalent SER existe
LEGACY_BLOCK_MIGRATED_ROUTES=true
# Logger les requêtes 404 du catchall
LEGACY_LOG_404=true

# =============================================================================
# iPXE / Déploiement réseau
# =============================================================================
SE4FS_IP=
SE4FS_NAME=
IPXE_URL=
SE4INSTALL_NAME=
SE4INSTALL_PASSWD=

# =============================================================================
# SE4FS - INSTANCE IDENTIFIER
# =============================================================================
# UUID unique identifiant cette instance SE4FS (généré automatiquement lors du setup)
SE4FS_INSTANCE_ID=fc31c204-5c4f-4033-9b75-00abea24e8d3
# Clé API de cette instance pour les communications inter-services (générée automatiquement)
SE4FS_INSTANCE_API_KEY=se4fs_instance_bf1c9c573b69b4510e1e234f79cc73eb

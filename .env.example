# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Sambaedu
# Environnement d'exécution: production, staging, local
# en dev: local
APP_ENV=production
# Activer le debug (affiche les erreurs détaillées) - JAMAIS true en production
APP_DEBUG=false
# Fuseau horaire de l'application
APP_TIMEZONE="Europe/Paris"
# URL racine de l'application 
APP_URL=
APP_KEY=
# =============================================================================
# LOGGING
# =============================================================================
# Canal de log: stack, single, daily
# en dev : stack & debug
LOG_CHANNEL=daily
# Niveau de log: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=info

# Pipeline déploiement WPKG (Story 15.1) — channel logs dédié wpkg-deploy
# Niveau : debug, info, warning, error
WPKG_DEPLOY_LOG_LEVEL=info
# Rétention en jours du fichier deploy-{date}.log (driver daily)
WPKG_DEPLOY_LOG_DAYS=30

# IPs/CIDRs LAN autorisés pour les endpoints machine (wpkg/reports, linux_out, winget_out...)
# Défaut localhost seul : configurer le CIDR du LAN en prod, sinon 403 sur les postes.
# Exemple : WPKG_ALLOWED_IPS=192.168.0.0/16,10.0.0.0/8
WPKG_ALLOWED_IPS=127.0.0.1,::1

# Story 17.6 — Endpoint /wpkg/winget_out.php (install OS Windows winget).
# Flag d'activation (parité legacy $config['winget']). false → 400 Bad request.
WPKG_WINGET_ENABLED=false
# Catalogues winget add/remove (surcharge admin /etc/ + défaut package /usr/share/).
# Décommenter pour surcharger les chemins par défaut.
# WPKG_WINGET_ADD_LOCAL=/etc/sambaedu/applications/winget/add.json
# WPKG_WINGET_ADD_DEFAULT=/usr/share/sambaedu/applications/winget/add.json
# WPKG_WINGET_REMOVE_LOCAL=/etc/sambaedu/applications/winget/remove.json
# WPKG_WINGET_REMOVE_DEFAULT=/usr/share/sambaedu/applications/winget/remove.json

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sambaedu
DB_USERNAME=sambaedu
DB_PASSWORD=

# =============================================================================
# CACHE & SESSIONS & QUEUES
# =============================================================================
# Driver de diffusion en temps réel
BROADCAST_DRIVER=log
# Driver cache Laravel. apc = APCu local (défaut prod), redis = cache partagé multi-host (Phase 3+), array = tests, file = fallback CI sans APCu.
CACHE_DRIVER=apc
# APP_CONTEXT_CACHE_DRIVER=apc # Override store app_context (défaut hardcodé = apc, n'hérite PAS de CACHE_DRIVER global — review #10 Story 16.15)
# Disque de stockage des fichiers
FILESYSTEM_DISK=local
# File d'attente des jobs: sync, database, redis, beanstalkd
QUEUE_CONNECTION=database
# Stockage de session: file, cookie, database, redis
SESSION_DRIVER=file
# Durée de vie de la session en minutes
SESSION_LIFETIME=120

# =============================================================================
# REDIS (optionnel, utilisé si CACHE_DRIVER=redis ou QUEUE_CONNECTION=redis)
# =============================================================================
REDIS_HOST=127.0.0.1
# Mot de passe Redis - généré automatiquement lors du setup
REDIS_PASSWORD=
REDIS_PORT=6379

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# SAMBAEDU - ÉTABLISSEMENT
# =============================================================================
# Nom affiché de l'établissement (rempli automatiquement depuis
# /etc/sambaedu/sambaedu.conf -> etab_name lors de l'installation si disponible).
# Si vide, config/sambaedu.php applique un fallback.
ESTABLISHMENT_NAME=

# =============================================================================
# ACTIVE DIRECTORY (Samba/AD)
# =============================================================================
# Les paramètres LDAP (host, port, base_dn, admin user/password, domain)
# sont lus depuis /etc/sambaedu/sambaedu.conf via SambaEduConfig — source
# de vérité unique partagée par SER et le bridge legacy.
#
# Serveur AD CENTRAL (fallback en cas d'indisponibilité de l'AD local)
SE4AD_IP=192.168.122.60

# Serveur AD LOCAL de l'établissement (prioritaire pour les requêtes)
SE4AD_ETAB_IP=192.168.122.60

# Restreindre l'accès LDAP au réseau local uniquement
STRICT_LOCAL_AD=true

# =============================================================================
# LEGACY
# =============================================================================
# Chemin absolu vers le legacy PHP
LEGACY_PATH=/var/www/sambaedu
# URL interne du vhost legacy (proxy HTTP pour isolation PHP)
LEGACY_BASE_URL=http://127.0.0.1:8082
# Bloquer l'accès aux routes legacy dont l'équivalent SER existe
LEGACY_BLOCK_MIGRATED_ROUTES=true
# Logger les requêtes 404 du catchall
LEGACY_LOG_404=true

# Story 5.1d — Connexion BDD MySQL legacy (lecture seule, consommée par la
# commande one-shot `php artisan quota:seed-from-legacy` qui importe la table
# `quotas` du legacy vers `quota_rules`). Laisser vide si non utilisée — la
# commande retourne FAILURE explicite avec un message clair.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_SOCKET=

# =============================================================================
# iPXE / Déploiement réseau
# =============================================================================
SE4FS_IP=
SE4FS_NAME=
IPXE_URL=
SE4INSTALL_NAME=
SE4INSTALL_PASSWD=

# =============================================================================
# Story 17.2 — GPO Applications scripts substitutions
# =============================================================================
# URL du serveur GLPI Agent (consommée par glpi/startup.linux).
# Laisser vide si GLPI non déployé.
SAMBAEDU_GLPI_URL=
# Nom du groupe AD « sans internet » (consommé par firewall/startup.windows
# et firewall/logon-system.windows). Laisser vide si pas de restriction.
SAMBAEDU_NO_INTERNET=
# Adresse réseau DHCP (ex: 192.168.1.0) — consommée par firewall/startup.windows.
# Forme simple (multi-VLAN non géré ici).
SAMBAEDU_DHCP_RESEAU=
# Masque sous-réseau DHCP (ex: 255.255.255.0) — consommée par firewall/startup.windows.
SAMBAEDU_DHCP_MASQUE=

# =============================================================================
# Installation Linux (preseed Debian/Ubuntu) — premier compte local non-root
# =============================================================================
# Compte créé par l'installateur (preseed passwd/username + user-password).
# Laisser VIDE = fallback config `basicuser` / `sambaedu-v5` (cf.
# config/sambaedu.php → sambaedu.linux.user). Si renseigné, le login doit être
# valide Debian : minuscule initiale, puis [a-z0-9], ≤ 32 caractères — sinon
# l'install se bloque sur « Identifiant non valable ».
SAMBAEDU_LINUX_USER=
SAMBAEDU_LINUX_USER_PASSWD=

# =============================================================================
# Installation Windows (autounattend) — compte local mode « perso » (hors domaine)
# =============================================================================
# Compte local injecté dans l'autounattend (AutoLogon + LocalAccount) quand le
# poste est installé en mode perso=1. Laisser VIDE = fallback config
# `basicuser` / `sambaedu-v5` (mêmes valeurs que Linux, cf. config/sambaedu.php
# → sambaedu.windows.win_user). En mode join domaine (perso=0) c'est le compte
# de service (se4install_*) qui est utilisé, pas celui-ci.
SAMBAEDU_WIN_USER=
SAMBAEDU_WIN_USER_PASSWD=

# Story 17.3 — Override URL endpoint applications-scripts (par défaut résolu
# dynamiquement via URL::route('agent.v1.config.applications-scripts') — URL
# native API v1 16.13).
#
# Pattern par défaut (vide) : résolution dynamique → URL native API v1.
#   Recommandé quand 100% du parc est JWT-migré (16.10+16.11 done généralisés).
#
# Pattern transition JWT (parc partiellement migré, post-review 17.3 Q3) :
#   tant que tous les postes Windows ne sont pas JWT-migrés au runtime
#   (cf. memo `feedback_auth_iso_legacy`), poser explicitement l'URL legacy :
#     SAMBAEDU_APPLICATIONS_SCRIPTS_URL=http://se4fs.<domain>/gpo/applications.php
#   qui est re-routée par `MigrationController::serveFragment(applications)`
#   (option β 16.13bis, `routes/web.php:618` `Route::match(['GET','POST'])`).
#   La route migration sert le bon fragment selon l'état JWT du poste.
#   Bascule définitive vers URL native quand la migration JWT est généralisée
#   (la commande `gpo:applications:audit` détectera l'écart côté template).
#
# Utile aussi en testing/CI ou pour pointer vers un endpoint custom (proxy).
SAMBAEDU_APPLICATIONS_SCRIPTS_URL=

# Story 17.3 — Override path template GPO `se4_applications` (par défaut
# /usr/share/sambaedu/gpo/se4_applications.zip — livré par paquet Debian
# `sambaedu-gpo`). Consommé par la commande artisan `gpo:applications:audit`.
# Sur la VM dev, le template est un répertoire (pas un .zip) — la commande
# détecte automatiquement via is_dir/is_file.
GPO_APPLICATIONS_TEMPLATE_PATH=

# =============================================================================
# Story 17.2 / 17.5 — Wrapping scripts applications (logging centralisé)
# =============================================================================
# Active le wrapping des scripts applications.php avec WrapperScriptRenderer pour logging centralisé (Story 17.5).
# Quand true, chaque interpréteur cmd/bash est wrappé avec un prefix setup + suffix POST vers /api/v1/script-execution-logs.
# Default false → comportement iso-legacy.
SAMBAEDU_SCRIPTS_LOGGING_ENABLED=false

# =============================================================================
# SE4FS - INSTANCE IDENTIFIER
# =============================================================================
# UUID unique identifiant cette instance SE4FS (généré automatiquement lors du setup)
SE4FS_INSTANCE_ID=fc31c204-5c4f-4033-9b75-00abea24e8d3
# Clé API de cette instance pour les communications inter-services (générée automatiquement)
SE4FS_INSTANCE_API_KEY=se4fs_instance_bf1c9c573b69b4510e1e234f79cc73eb

# =============================================================================
# Story 16.12 — ScriptsOs (logs exécution centralisés)
# =============================================================================
# Rétention DB en jours — au-delà, archivage daily 03:30 vers
# storage/archives/script-execution-logs-YYYY-MM.jsonl.gz puis purge DB.
SCRIPTSOS_RETENTION_DAYS=90
# Path archives (par défaut storage/archives). Laisser vide pour défaut.
SCRIPTSOS_ARCHIVE_PATH=
# Channel logs Laravel `scriptsos` (driver daily) — verbosité.
SCRIPTSOS_LOG_LEVEL=debug
# Rétention rotation channel logs `scriptsos` (jours).
SCRIPTSOS_LOG_RETENTION=30
# Tolérance clock-skew sur `started_at` côté endpoint d'ingestion.
SCRIPTSOS_SKEW_FUTURE=300
SCRIPTSOS_SKEW_PAST=604800
# TTL cache (s) pour le bandeau d'indicateurs UI (taux échec 24h + top 5).
SCRIPTSOS_STATS_CACHE_TTL=60

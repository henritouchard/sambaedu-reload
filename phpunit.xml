<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>requires-postgres</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_ENV" value="testing"/>
        <!-- TEST KEY ONLY — NEVER use in production.
             Test stability requires a deterministic APP_KEY in CI/local (avoids
             EncrypterMissingKeyException when running tests without `.env`).
             Cette clé ne déchiffre AUCUN secret de prod. Ne jamais la copier
             dans `.env` ni dans un environnement réel. — Post-review 3.7 #6. -->
        <env name="APP_KEY" value="base64:ffV+ltRrvfh14I7SufozBkRu/+HIvXwDmmJDoGCbbS4="/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config-testing.php"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="APP_CONTEXT_CACHE_DRIVER" value="array"/><!-- Story 16.15 : store dédié app_context forcé en array pour les tests -->
        <env name="LOG_CHANNEL" value="null"/>
        <!-- Tests par défaut sur SQLite :memory: (schémas créés manuellement
             par setUp() des tests).

             CES DEUX LIGNES SONT UN DÉFAUT, PAS UNE GARDE. Vérifié : `force`
             ne l'emporte PAS sur une variable déjà exportée dans le shell, ni
             sous `artisan test` ni sous `phpunit`. La protection réelle est
             ailleurs — {@see \Tests\TestCase} refuse de démarrer sur toute base
             qui n'est ni SQLite ni suffixée `_test`, et fait échouer chaque test
             avec un message explicite. C'est elle qui tient, pas ceci.

             ⚠️ POUR LANCER CONTRE POSTGRES (nécessaire pour Windows/Wpkg) :
             retirer ces deux lignes NE MÈNE PAS à une base de test. `DB_DATABASE`
             est alors hérité du `.env`, donc la base de l'instance — la garde
             ci-dessus vous arrêtera, mais autant nommer la base explicitement :

                 DB_CONNECTION=pgsql DB_DATABASE=sambaedu_test vendor/bin/phpunit
        -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <ini name="apc.enable_cli" value="1"/>
    </php>
</phpunit>

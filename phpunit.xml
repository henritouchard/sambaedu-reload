<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>requires-postgres</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_ENV" value="testing"/>
        <!-- TEST KEY ONLY — NEVER use in production.
             Test stability requires a deterministic APP_KEY in CI/local (avoids
             EncrypterMissingKeyException when running tests without `.env`).
             Cette clé ne déchiffre AUCUN secret de prod. Ne jamais la copier
             dans `.env` ni dans un environnement réel. — Post-review 3.7 #6. -->
        <env name="APP_KEY" value="base64:ffV+ltRrvfh14I7SufozBkRu/+HIvXwDmmJDoGCbbS4="/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config-testing.php"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="APP_CONTEXT_CACHE_DRIVER" value="array"/><!-- Story 16.15 : store dédié app_context forcé en array pour les tests -->
        <env name="LOG_CHANNEL" value="null"/>
        <!-- Tests par défaut sur SQLite :memory: (schémas créés manuellement
             par setUp() des tests). Pour lancer contre Postgres sambaedu_test
             (nécessaire pour Windows/Wpkg), supprimer ces 2 lignes. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <ini name="apc.enable_cli" value="1"/>
    </php>
</phpunit>

{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-apcu": "*",
        "ext-imagick": "*",
        "ext-sodium": "*",
        "apereo/phpcas": "~1.6",
        "arthurhoaro/favicon": "~2.0",
        "czproject/git-php": "~4.3",
        "darkaonline/l5-swagger": "^10.0",
        "devrabiul/laravel-toaster-magic": "^1.4",
        "directorytree/ldaprecord": "^3.8",
        "directorytree/ldaprecord-laravel": "^3.4",
        "ezyang/htmlpurifier": "~4.12",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "flynsarmy/slim-monolog": "~1.0",
        "fortawesome/font-awesome": "^7.0",
        "guzzlehttp/guzzle": "^7.2",
        "influxdata/influxdb-client-php": "~3.2.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "league/oauth2-client": "^2.4",
        "livewire/livewire": "^4.3",
        "maxh/php-nominatim": "~2.3",
        "mrkampf/proxmox-ve": "~0.5",
        "robthree/twofactorauth": "~2.1",
        "sabre/dav": "~4.4",
        "sambaedu/bigbluebutton-api-php": "2.0.12",
        "slim/slim": "~4.12",
        "spatie/laravel-permission": "^6.24",
        "spipu/html2pdf": "~5.2",
        "spomky-labs/otphp": "^11.4",
        "twbs/bootstrap": "~5.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "fakerphp/faker": "^1.9.1",
        "laravel/dusk": "^8.6",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Controllers\\": "app/Http/Controllers/",
            "ApiV1\\": "app/Http/Controllers/Api/v1/",
            "Services\\": "app/Services/",
            "Utils\\": "app/Utils/",
            "Middleware\\": "app/Http/Middleware/",
            "Requests\\": "app/Http/Requests/",
            "Resources\\": "app/Http/Resources/",
            "Jobs\\": "app/Jobs/",
            "Events\\": "app/Events/",
            "Listeners\\": "app/Listeners/",
            "Models\\": "app/Models/"
        },
        "files": [
            "app/Helpers/SEHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "clear": [
            "@php artisan sambaedu:clear-cache"
        ],
        "clear:all": [
            "@php artisan sambaedu:clear-cache --all"
        ],
        "clear:optimize": [
            "@php artisan sambaedu:clear-cache --optimize"
        ],
        "docs": [
            "@php artisan sambaedu:update-docs"
        ],
        "docs:check": [
            "@php artisan sambaedu:update-docs --check"
        ],
        "test": [
            "@php artisan test"
        ],
        "test:coverage": [
            "@php artisan test --coverage"
        ],
        "dusk": [
            "bin/dusk"
        ],
        "lint": [
            "@php ./vendor/bin/pint --test"
        ],
        "format": [
            "@php ./vendor/bin/pint"
        ],
        "deploy": [
            "@composer install --no-dev --optimize-autoloader",
            "@php artisan vendor:publish --tag=livewire:assets --force",
            "@php artisan sambaedu:clear-cache --quiet",
            "@php artisan migrate --force",
            "@php artisan sambaedu:clear-cache --optimize --quiet",
            "@php artisan sambaedu:update-docs --quiet"
        ],
        "setup": [
            "@composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan vendor:publish --tag=livewire:assets --force",
            "@php artisan migrate:fresh",
            "@php artisan sambaedu:clear-cache --optimize"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {
            "php": "8.2.29"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

echo "mise en place serveur ltsp"

if [ ! -f "/etc/apt/sources.list.d/ltsp-ubuntu-ppa-focal.list" ]; then
    curl -o  /etc/apt/sources.list.d/ltsp-ubuntu-ppa-focal.list https://ltsp.org/misc/ltsp-ubuntu-ppa-focal.list
    curl -o /etc/apt/trusted.gpg.d/ltsp_ubuntu_ppa.gpg https://ltsp.org/misc/ltsp_ubuntu_ppa.gpg
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y ltsp ltsp-binaries nfs-kernel-server squashfs-tools dnsmasq
fi
echo "[clients]
CUPS_SERVER=\"localhost\"" > /etc/ltsp/ltsp.conf

if [ ! -f /srv/ltsp/images/x86_64.img ] ; then
    # a refaire en cas de modif du serveur
    ltsp image /
fi
ltsp nfs
ltsp initrd
ltsp ipxe
ltsp dnsmasq -d0 -p0 -r0 -t1 2> /dev/null || true
